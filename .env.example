# Security Settings (REQUIRED for production)
SECRET_KEY=Secret-keyyy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=postgresql://chemezy:chemezy@localhost/chemezy

# CORS Security
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# PubChem API Settings
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
PUBCHEM_TIMEOUT=10


# Application Settings
APP_NAME=Chemezy Backend Engine
DEBUG=false

# OpenAI-Compatible API Settings (works with any OpenAI-compatible provider)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.your-provider.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
